# Copiá este archivo a .env.local y completá los valores. NO subas .env.local a GitHub.

# Si está vacío o no existe, la app funciona en modo demo (datos en el navegador, localStorage).
# Si tiene valor, la app lee y escribe contra n8n (URL de PRODUCCIÓN del webhook, sin barra final).
# Ejemplo n8n:  https://tu-n8n.example.com/webhook
# Ejemplo mock: http://localhost:8787
VITE_API_BASE_URL=

# Opcional. Se envía en el header X-API-Key.
# ATENCIÓN: todo lo que empieza con VITE_ queda incrustado en el JavaScript público del sitio.
# Cualquiera puede verlo desde el navegador; no es seguridad real.
VITE_API_KEY=
