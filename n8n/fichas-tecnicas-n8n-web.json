      "parameters": {
        "jsCode": "// Si completás CLAVE, la web tiene que enviar el mismo valor en el header X-API-Key (VITE_API_KEY).\nconst CLAVE = '';\nconst REQ = $('Webhook estado').first().json;\nif (CLAVE && (REQ.headers || {})['x-api-key'] !== CLAVE) return [{ json: { error: 'No autorizado', status: 401 } }];\nconst b = REQ.body || {};\nconst err = (m, s) => [{ json: { error: m, status: s || 400 } }];\nconst ESTADOS = ['Pendiente', 'En producción', 'Terminada', 'Entregada'];\nconst id = String(b.idCarga || '').trim();\nif (!/^FT-\\d+$/.test(id)) return err('ID de carga inválido');\nif (!ESTADOS.includes(b.estado)) return err('Estado inválido');\nconst filas = $input.all().map(i => i.json).filter(r => r['ID de carga'] === id);\nif (!filas.length) return err('No se encontró la carga ' + id, 404);\nreturn filas.map(r => ({ json: { 'ID de fila': r['ID de fila'], 'Estado': b.estado, idCarga: id } }));"
      },
