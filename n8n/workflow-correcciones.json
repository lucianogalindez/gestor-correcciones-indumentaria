        "jsCode": "const s = (v) => (v === undefined || v === null ? '' : String(v).trim());\nconst ESTADOS = ['Pendiente', 'En corrección', 'Para revisar', 'Cerrada'];\nconst sinTildes = (t) => s(t).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst filaAObjeto = (r) => ({\n  id: s(r['ID']), codigo: s(r['Artículo']), version: s(r['Versión de muestra']), talle: s(r['Talle']),\n  color: s(r['Color']), proveedor: s(r['Proveedor/taller']), tipo: s(r['Tipo de corrección']),\n  detalle: s(r['Detalle']), enlace: s(r['Enlace de referencia']), responsable: s(r['Responsable']),\n  fecha: s(r['Fecha requerida']), creada: s(r['Fecha de creación']), estado: s(r['Estado']),\n  cierre: s(r['Fecha de cierre']),\n});\n// Filas en blanco (sin ID) se ignoran.\nconst filas = $input.all().map((i) => i.json).filter((r) => s(r['ID']) !== '');\n\nreturn [{ json: { items: filas.map(filaAObjeto) } }];\n"
