      "parameters": {
        "jsCode": "const s = (v) => (v === undefined || v === null ? '' : String(v).trim());\nconst ESTADOS = ['Pendiente', 'En corrección', 'Para revisar', 'Cerrada'];\nconst sinTildes = (t) => s(t).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst filaAObjeto = (r) => ({\n  id: s(r['ID']), codigo: s(r['Artículo']), version: s(r['Versión de muestra']), talle: s(r['Talle']),\n  color: s(r['Color']), proveedor: s(r['Proveedor/taller']), tipo: s(r['Tipo de corrección']),\n  detalle: s(r['Detalle']), enlace: s(r['Enlace de referencia']), responsable: s(r['Responsable']),\n  fecha: s(r['Fecha requerida']), creada: s(r['Fecha de creación']), estado: s(r['Estado']),\n  cierre: s(r['Fecha de cierre']),\n});\n// Filas en blanco (sin ID) se ignoran.\nconst filas = $input.all().map((i) => i.json).filter((r) => s(r['ID']) !== '');\n\nconst b = $('Webhook crear').first().json.body ?? {};\nconst campos = ['codigo', 'version', 'talle', 'color', 'proveedor', 'tipo', 'detalle', 'responsable', 'fecha'];\nconst faltan = campos.filter((c) => s(b[c]) === '');\nif (faltan.length) {\n  return [{ json: { status: 400, respuesta: { error: 'Faltan campos: ' + faltan.join(', ') } } }];\n}\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(s(b.fecha))) {\n  return [{ json: { status: 400, respuesta: { error: 'La fecha requerida debe ser AAAA-MM-DD' } } }];\n}\n// Siguiente ID: COR-0001, COR-0002, ...\nconst max = filas.reduce((m, r) => {\n  const n = Number((/^COR-(\\d+)$/.exec(s(r['ID'])) || [])[1] || 0);\n  return Math.max(m, n);\n}, 0);\nconst id = 'COR-' + String(max + 1).padStart(4, '0');\nconst creada = new Date().toISOString();\n\nconst respuesta = {\n  id, codigo: s(b.codigo), version: s(b.version), talle: s(b.talle), color: s(b.color),\n  proveedor: s(b.proveedor), tipo: s(b.tipo), detalle: s(b.detalle), enlace: s(b.enlace),\n  responsable: s(b.responsable), fecha: s(b.fecha), creada, estado: 'Pendiente', cierre: '',\n};\nconst row = {\n  'ID': respuesta.id, 'Artículo': respuesta.codigo, 'Versión de muestra': respuesta.version,\n  'Talle': respuesta.talle, 'Color': respuesta.color, 'Proveedor/taller': respuesta.proveedor,\n  'Tipo de corrección': respuesta.tipo, 'Detalle': respuesta.detalle,\n  'Enlace de referencia': respuesta.enlace, 'Responsable': respuesta.responsable,\n  'Fecha requerida': respuesta.fecha, 'Fecha de creación': respuesta.creada,\n  'Estado': respuesta.estado, 'Fecha de cierre': '',\n};\nreturn [{ json: { status: 200, respuesta, row } }];\n"
      },
