    {
      "parameters": {
        "jsCode": "const s = (v) => (v === undefined || v === null ? '' : String(v).trim());\nconst ESTADOS = ['Pendiente', 'En corrección', 'Para revisar', 'Cerrada'];\nconst sinTildes = (t) => s(t).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst filaAObjeto = (r) => ({\n  id: s(r['ID']), codigo: s(r['Artículo']), version: s(r['Versión de muestra']), talle: s(r['Talle']),\n  color: s(r['Color']), proveedor: s(r['Proveedor/taller']), tipo: s(r['Tipo de corrección']),\n  detalle: s(r['Detalle']), enlace: s(r['Enlace de referencia']), responsable: s(r['Responsable']),\n  fecha: s(r['Fecha requerida']), creada: s(r['Fecha de creación']), estado: s(r['Estado']),\n  cierre: s(r['Fecha de cierre']),\n});\n// Filas en blanco (sin ID) se ignoran.\nconst filas = $input.all().map((i) => i.json).filter((r) => s(r['ID']) !== '');\n\nconst b = $('Webhook estado').first().json.body ?? {};\nconst id = s(b.id);\nconst estado = ESTADOS.find((e) => sinTildes(e) === sinTildes(b.estado));\nif (!id || !estado) {\n  return [{ json: { status: 400, respuesta: { error: 'Se requiere id y un estado válido' } } }];\n}\nconst fila = filas.find((r) => s(r['ID']) === id);\nif (!fila) {\n  return [{ json: { status: 404, respuesta: { error: 'No existe la solicitud ' + id } } }];\n}\nconst cierre = estado === 'Cerrada' ? s(b.cierre) : '';\nif (estado === 'Cerrada' && !/^\\d{4}-\\d{2}-\\d{2}$/.test(cierre)) {\n  return [{ json: { status: 400, respuesta: { error: 'La fecha de cierre debe ser AAAA-MM-DD' } } }];\n}\nconst respuesta = { ...filaAObjeto(fila), estado, cierre };\nconst update = { 'ID': id, 'Estado': estado, 'Fecha de cierre': cierre };\nreturn [{ json: { status: 200, respuesta, update } }];\n"
      },
