        0
      ],
      "id": "7ffb2826-f3e5-47ae-86bb-5f6f0fd801fb",
      "name": "Leer filas actuales",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Toma la respuesta de OpenAI, la convierte en filas (una por color) y la deja lista para agregar al Sheet.\nconst r = $('OpenAI analizar ficha').first().json;\nlet t = '';\nconst msg = (r.output || []).find(o => o.type === 'message');\nif (msg) { const p = (msg.content || []).find(c => c.type === 'output_text'); t = p ? p.text : ''; }\nif (!t) t = r.text || r.output_text || (r.message && r.message.content) || '';\nif (!t) throw new Error('OpenAI no devolvió datos');\nconst d = (typeof t === 'object') ? t : JSON.parse(String(t).replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\nconst txt = v => String(v === undefined || v === null ? '' : v).trim();\nconst ent = v => { const n = parseInt(String(v === undefined || v === null ? '' : v).replace(/[^\\d]/g, ''), 10); return isNaN(n) ? 0 : n; };\nconst colores = Array.isArray(d.colores) ? d.colores : [];\nif (!colores.length) throw new Error('No se encontraron colores en la ficha');\nconst total = ent(d.cantidadTotal);\nconst suma = colores.reduce((a, c) => a + ent(c.cantidad), 0);\nif (suma !== total) throw new Error('La suma de los colores (' + suma + ') no coincide con el total (' + total + ')');\nconst filas = $input.all().map(i => i.json).filter(x => x['ID de carga']);\nconst art = txt(d.articulo), oc = txt(d.ordenCompra);\nconst dup = filas.find(x => txt(x['Artículo']) === art && txt(x['Orden de compra']) === oc);\nif (dup) throw new Error('Ya existe una carga para el artículo ' + art + ' con la OC ' + oc + ' (' + dup['ID de carga'] + ')');\nlet max = 0;\nfor (const x of filas) { const m = /^FT-(\\d+)$/.exec(String(x['ID de carga'] || '')); if (m) max = Math.max(max, Number(m[1])); }\nconst id = 'FT-' + String(max + 1).padStart(4, '0');\nconst bin = ($('Webhook subir').first().binary || {}).file || {};\nconst ahora = new Date().toISOString();\nreturn colores.map((c, i) => ({ json: {\n  'ID de carga': id, 'Cargado el': ahora, 'Artículo': art, 'Modelo': txt(d.modelo), 'Temporada': txt(d.temporada), 'Línea': txt(d.linea),\n  'Orden de compra': oc, 'Proveedor': txt(d.proveedor), 'Tela': txt(d.tela), 'Cantidad total de prendas': total,\n  'Código de color': txt(c.codigo), 'Color': txt(c.color), 'Cantidad del color': ent(c.cantidad), 'Estado': 'Pendiente',\n  'Fecha de la ficha': txt(d.fecha), 'Archivo de origen': bin.fileName || '', 'ID de fila': id + '-' + String(i + 1).padStart(2, '0')\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
